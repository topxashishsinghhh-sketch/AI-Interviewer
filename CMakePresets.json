{
  "version": 4,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with JSON storage",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "displayName": "Release",
      "description": "Release build with JSON storage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "AddressSanitizer",
      "description": "Debug build with ASan/UBSan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -Wshadow -Wconversion -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "mongo",
      "inherits": "debug",
      "displayName": "MongoDB Debug",
      "description": "Debug build with MongoDB backend",
      "cacheVariables": {
        "USE_MONGO": "ON"
      }
    },
    {
      "name": "gui",
      "displayName": "GUI Debug",
      "description": "Debug build with Qt GUI (requires the Qt-bundled MinGW GCC 13 toolchain)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-gui",
      "toolchainFile": "${sourceDir}/cmake/qt-mingw.cmake",
      "cacheVariables": {
        "BUILD_GUI": "ON",
        "BUILD_GUI_TESTS": "ON",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.2/mingw_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "build-debug", "configurePreset": "debug" },
    { "name": "build-release", "configurePreset": "release" },
    { "name": "build-asan", "configurePreset": "asan" },
    { "name": "build-mongo", "configurePreset": "mongo" },
    { "name": "build-gui", "configurePreset": "gui" }
  ],
  "testPresets": [
    { "name": "test-debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "test-gui", "configurePreset": "gui", "output": { "outputOnFailure": true } }
  ]
}