# AI Interviewer Environment Variables
# Copy to .env and customize (do not commit .env)

# Storage backend: json | mongo (default: json)
STORAGE_BACKEND=json

# MongoDB connection (used when STORAGE_BACKEND=mongo)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_interviewer

# Bootstrap admin created by seed_db (set these; the tool falls back to
# local-development values that must not be used on a shared server)
SEED_ADMIN_EMAIL=admin@interviewer.local
SEED_ADMIN_PASSWORD=

# Application settings
APP_DATA_DIR=./data
QUESTIONS_DIR=./data/questions
CHALLENGES_DIR=./challenges
SUBMISSIONS_DIR=./data/submissions